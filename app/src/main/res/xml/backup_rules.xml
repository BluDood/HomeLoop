<full-backup-content>
    <!-- Video URIs and service/runtime state are device-specific. Optimized media is generated. -->
    <exclude domain="sharedpref" path="video_widget_playback.xml" />
    <exclude domain="file" path="optimized/" />
</full-backup-content>
